meta {
  name: Create Key
  type: http
  seq: 3
}

post {
  url: {{base_url}}/api/v1/vaults/{{vault_name}}/keys
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "name": "my-rsa-key",
    "type": "RSA",
    "bits": 2048,
    "exportable": true,
    "tags": ["env:dev"]
  }
}
