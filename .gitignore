# Config files contain secrets — never commit
.password-manager*.yaml

# RocketVault instance configuration — contains live secrets (master_key,
# bootstrap_token, hsm.pin). Never commit. Copy .rocketvault.yaml.example to
# .rocketvault.yaml and fill in generated values instead. This exact class of
# mistake shipped for 5+ months once already — see .claude/known-bugs.md (B10)
# and .claude/security-incident-2026-03-07.md. The pattern below covers both
# dash-separated (.rocketvault-production.yaml) and dot-separated
# (.rocketvault.prod.yaml) sibling names — a prior version only matched the
# dash form, which was the same class of gap that caused the original
# incident.
.rocketvault.yaml
.rocketvault[.-]*.yaml
.rocketvault.yaml.local
!.rocketvault.yaml.example

# Database files
*.db
*.sqlite
*.sqlite3
*.db-shm
*.db-wal

# Application binaries. rocketvault-* is compiled release binaries only — it
# does NOT match .rocketvault*.yaml (leading dot, no trailing dash). See the
# dedicated block above for config files.
rocketvault
rocketvault.exe
rocketvault-*
!docs/assets/rocketvault-*.svg

