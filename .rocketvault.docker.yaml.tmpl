# Docker / Fly.io / Railway Runtime Configuration Template
#
# docker-entrypoint.sh renders this into /app/.rocketvault.yaml at container
# startup via envsubst, substituting all ${VAR} placeholders from the
# container environment. Never put real secrets in this file -- it is
# committed to version control. Set values via .env (compose), `fly secrets
# set` (Fly.io), or Railway service variables.
#
# One template covers both database drivers: docker-entrypoint.sh sets
# RV_DATABASE_DRIVER, RV_DATABASE_CONNECTION, and RV_LOG_FILE differently
# depending on RV_DB_DRIVER (sqlite3 -- the default, used by Railway and
# plain "docker run" -- or postgres, used by docker-compose.yml and
# fly.toml, which both set RV_DB_DRIVER=postgres explicitly). See
# docker-entrypoint.sh's own header comment for exactly what each mode sets.
#
# RV_HSM_ENABLED=true additionally makes docker-entrypoint.sh initialize a
# SoftHSM2 software token inside the container (persisted under /app/data),
# so the HSM-only code paths (OCT/AES key creation, secp256k1 signing) work
# without a real hardware HSM. See docker-entrypoint.sh's header comment.

master_key: "${RV_MASTER_KEY}"

# JWT signing configuration. key_source is "self_pki" (not "os_store")
# because containers have no OS keychain to back github.com/zalando/go-keyring;
# self_pki stores the signing key encrypted inside the SQLite/Postgres
# database itself via CryptoService/KeyRepository, so it persists alongside
# the rest of the data with no separate key file or keychain to lose on
# redeploy. No "jwt_secret" key here: HS256 was removed in favor of
# asymmetric-only signing (see CLAUDE.md), so that key is never read.
jwt:
  key_source: "self_pki"
  key_cn: "rocketvault"
  expiry: "1h"
  rotation_overlap: "1h"
  signing_key_file: ""

bootstrap_token: "${RV_BOOTSTRAP_TOKEN}"

environment: "production"

# Database Configuration -- see the header comment above for how these two
# values are set per driver.
database:
  connection: "${RV_DATABASE_CONNECTION}"
  driver: "${RV_DATABASE_DRIVER}"

log:
  level: "info"
  file: "${RV_LOG_FILE}"
  format: "json"
  pretty_print: false
  max_backups: 3
  max_age_days: 7
  max_size_mb: 10
  rotation_method: "size"

rate_limit:
  default: 300
  auth: 5

server:
  listen_addr: ":8774"
  read_timeout: "30s"
  write_timeout: "30s"
  idle_timeout: "120s"
  cors_allowed_origins:
    - "${RV_CORS_ORIGINS}"
  # Reverse proxies whose X-Forwarded-For / X-Real-IP headers may be trusted,
  # as IP addresses or CIDR ranges. Leave empty when clients connect directly:
  # the headers are then ignored, since any client can forge them. Behind a
  # proxy (Railway, Fly, nginx) set this to the proxy's address range, or every
  # client shares the proxy's rate-limit bucket. An invalid entry is logged as
  # an error and the whole list is ignored.
  trusted_proxies: []
  http2:
    enabled: true
  tls:
    enabled: false
    cert_file: ""
    key_file: ""

monitoring:
  enable_metrics: true
  metrics_interval: "60s"
  slow_query_threshold: "500ms"

health:
  check_interval: "60s"
  database_timeout: "10s"
  enable_detailed_metrics: true

retry:
  database:
    enabled: true
    max_attempts: 3
    initial_delay: "100ms"
    max_delay: "5s"
    backoff_multiplier: 2.0
    retryable_errors:
      - "connection refused"
      - "database is locked"
      - "busy"
      - "timeout"
    jitter_enabled: true
  external_services:
    enabled: true
    max_attempts: 3
    initial_delay: "1s"
    max_delay: "30s"
    backoff_multiplier: 2.0
    retryable_errors:
      - "connection refused"
      - "no such host"
      - "timeout"
      - "temporary failure"
      - "service unavailable"
      - "too many requests"
    jitter_enabled: true
  service_operations:
    enabled: true
    max_attempts: 2
    initial_delay: "100ms"
    max_delay: "1s"
    backoff_multiplier: 1.5
    retryable_errors:
      - "connection refused"
      - "timeout"
      - "temporary failure"
    jitter_enabled: true
  circuit_breaker:
    failure_threshold: 3
    timeout: "30s"
    half_open_requests: 2

soft_delete:
  enabled: true
  retention_days: 30
  purge_protection: false

key_cache:
  enabled: true
  ttl: "60s"
  max_entries: 500
  cleanup_interval: "30s"

oauth2:
  token_expiry: "30m"
  issuer: "${RV_ISSUER}"

vault_client:
  url: "http://localhost:8774"
  client_id: ""
  secrets: []

frontend:
  public_api_url: "http://localhost:8774"
  sentry_dsn: ""

hsm:
  enabled: ${RV_HSM_ENABLED}
  lib_path: /usr/lib/softhsm/libsofthsm2.so
  token_label: rocketvault
  pin: "${RV_HSM_PIN}"
  # 0 is not a literal slot index here -- PKCS11Config.SlotID is only used as
  # a raw slot number when > 0. At 0, findSlot() (internal/crypto/pkcs11_provider.go)
  # ignores slot numbering and matches by token_label instead, which is what
  # SoftHSM2 needs: it reassigns slot numbers on every --init-token run.
  slot_id: 0
